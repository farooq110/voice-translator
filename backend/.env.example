# Copy to `.env` and adjust. Every setting can also be provided as a real
# environment variable (12-factor). Secrets never go into the frontend.

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- STT (local CPU Whisper via faster-whisper) ---
# Model size: tiny | base | small. Default `small` — accuracy tier for
# low-resource languages like Urdu (ADR-0007).
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_WORKER_THREADS=1
STT_TIMEOUT_SECONDS=30
LOW_CONFIDENCE_THRESHOLD=0.60
# Accuracy decoding (ADR-0007): beam search + Silero VAD filter.
STT_BEAM_SIZE=5
STT_VAD_FILTER=true
STT_VAD_MIN_SILENCE_MS=500
STT_VAD_SPEECH_PAD_MS=250

# --- Server-side VAD gate (Phase 2, ADR-0009) ---
# Silero VAD runs BEFORE the STT model: silence/noise is rejected without
# decoding, utterances are edge-trimmed to their speech region, and
# over-long buffers are split at natural pauses (≥700 ms).
VAD_GATE_ENABLED=true
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=120
VAD_TRIM_PAD_MS=200
VAD_SPLIT_SILENCE_MS=700
VAD_SPLIT_MAX_SECONDS=24

# --- STT admission / backpressure (Phase 2) ---
# Global cap on utterances decoding/queued; overflow answers a non-fatal
# `server_busy` error instead of queueing without bound.
STT_MAX_QUEUE_DEPTH=16
# Per-session cap on simultaneously decoding utterances.
STT_MAX_PENDING_PER_SESSION=4

# HuggingFace cache location (kept inside the project on purpose).
# HF_HOME=/home/z/my-project/models/huggingface
# Mirror to use if huggingface.co is unreachable from your network:
# HF_ENDPOINT=https://hf-mirror.com

# --- Audio protocol limits (docs/audio-protocol.md) ---
AUDIO_SAMPLE_RATE=16000
MAX_CHUNK_BYTES=262144
MAX_UTTERANCE_SECONDS=30
MIN_UTTERANCE_SECONDS=0.2
WS_IDLE_TIMEOUT_SECONDS=180

# --- Sessions / security ---
MAX_SESSIONS=50
# Comma-separated CORS origins; empty = same-origin only (recommended).
CORS_ORIGINS=

# --- Translation decision engine (Phase 3, ADR-0012) ---
# local  = offline CTranslate2 OPUS-MT models (models/translation/<src>-<tgt>;
#          provision once: uv run python scripts/download_translation_models.py)
# fake   = deterministic stub ([fake:src→tgt] …) · libre = LibreTranslate HTTP
# none   = translation disabled (no decisions, Phase 1/2 protocol shape)
TRANSLATION_PROVIDER=local
# auto = detect per utterance (ur/hi cluster + confidence gate), decode pinned
# to the resolved language · pinned = assume the native language (faster, but
# Rule 2 can never fire)
TRANSLATION_DETECT_MODE=auto
TRANSLATION_CONFIDENCE_THRESHOLD=0.60
TRANSLATION_TIMEOUT_S=8
TRANSLATION_RATE_LIMIT_PER_MINUTE=30
TRANSLATION_MAX_CONCURRENT=2
TRANSLATION_MAX_TEXT_CHARS=2000
TRANSLATION_WORKER_THREADS=1
TRANSLATION_MODELS_DIR=models/translation
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
